<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scau.village.module.moment.mapper.MomentMapper">

    <!-- 动态列表结果映射 -->
    <resultMap id="MomentVOMap" type="com.scau.village.module.moment.dto.MomentVO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="user_avatar" property="userAvatar"/>
        <result column="content" property="content"/>
        <result column="images" property="images"/>
        <result column="likes_count" property="likesCount"/>
        <result column="comments_count" property="commentsCount"/>
        <result column="is_liked" property="isLiked"/>
        <result column="create_time" property="createTime"/>
        <!-- comments 不在列表查询中返回，在详情中单独查询 -->
    </resultMap>

    <!-- 分页查询动态列表 -->
    <select id="selectMomentList" resultMap="MomentVOMap">
        SELECT
            m.id,
            m.user_id,
            u.real_name AS user_name,
            u.avatar AS user_avatar,
            m.content,
            m.images,
            m.likes_count,
            m.comments_count,
            m.create_time,
            <!-- 判断当前用户是否已点赞 -->
            <choose>
                <when test="userId != null">
                    CASE WHEN ml.id IS NOT NULL THEN 1 ELSE 0 END AS is_liked
                </when>
                <otherwise>
                    0 AS is_liked
                </otherwise>
            </choose>
        FROM moment m
        LEFT JOIN `user` u ON m.user_id = u.id
        LEFT JOIN moment_like ml ON m.id = ml.moment_id AND ml.user_id = #{userId}
        WHERE m.tenant_id = #{tenantId}
          AND m.status = 1
        ORDER BY m.create_time DESC
    </select>

</mapper>